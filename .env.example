# ── Приложение ────────────────────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO
# Требовать API-токен для каждого запуска и запроса подтверждения. Выпустить его:
# `make token EMAIL=you@example.com APPROVE=1`. Эндпоинт /health показывает
# настройку, чтобы случайное отключение было заметно.
AUTH_ENABLED=true

# ── Локальное хранилище ──────────────────────────────────────────────────────
# Локальный профиль не требует PostgreSQL или Redis. Путь должен находиться
# внутри постоянного Docker volume в пользовательской конфигурации.
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/ai_operations_agent.db
CACHE_BACKEND=memory

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432   # изменить, если порт уже занят локальным PostgreSQL
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=ai_operations_agent

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# Кэшировать результаты инструментов чтения между запусками. Недоступность Redis
# приводит только к промаху кэша, но не к сбою расследования.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# ── LLM ───────────────────────────────────────────────────────────────────────
# Ollama запускает модель локально. При LLM_ENABLED=false используется
# детерминированный сценарий без модели; граф, инструменты и ограничения работают.
LLM_ENABLED=true
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# ── Ограничения агента ────────────────────────────────────────────────────────
MAX_TOOL_CALLS=12
MAX_WORKFLOW_STEPS=30
TOOL_TIMEOUT_SECONDS=15

# ── Слой интеграции MCP ───────────────────────────────────────────────────────
# При false агент использует встроенные тестовые провайдеры вместо подключения
# к четырём MCP-серверам.
MCP_ENABLED=true

# ── Хранение состояния воркфлоу ───────────────────────────────────────────────
# SQLite и PostgreSQL переживают перезапуск; memory предназначен только для тестов.
CHECKPOINTER=sqlite

# ── Наблюдаемость ─────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
